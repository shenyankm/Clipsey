# ==========================================
# Clipsey 浏览器扩展 - Git 忽略规则
# WXT Framework + Vite + TypeScript + Vue 3
# ==========================================

# ========== 依赖目录 ==========
node_modules/

# ========== WXT 构建产物 ==========
# WXT 输出目录
.output/
# WXT 临时文件和缓存
.wxt/
# 生产构建产物
dist/
# 浏览器扩展打包文件
*.crx
*.zip
*.xpi

# ========== Vite 相关 ==========
# Vite 缓存目录
.vite/
# Vite 配置时间戳文件
vite.config.ts.timestamp-*

# ========== TypeScript 编译产物 ==========
*.tsbuildinfo
*.tsbuildinfo.*

# ========== 测试覆盖率报告 ==========
coverage/
.nyc_output/
*.lcov

# ========== 日志文件 ==========
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ========== 环境变量文件 ==========
.env
.env.local
.env.*.local
.env.production
.env.development
.env.test
# 保留示例配置文件
!.env.example

# ========== IDE 编辑器配置 ==========
# Qoder IDE
.qoder/
# JetBrains 系列
.idea/
*.iml
*.iws
*.ipr
out/
# VS Code（保留推荐配置）
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
# Vim
*.swp
*.swo
*.swn
# 临时备份文件
*.bak
*.tmp
*.temp
*~

# ========== 操作系统文件 ==========
# macOS
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk
# Linux
.directory
.Trash-*

# ========== 工具链缓存 ==========
.eslintcache
.stylelintcache
.cache/
.parcel-cache/
# TypeScript 编译缓存
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# ========== 包管理器相关 ==========
# 压缩包
*.tgz
*.tar.gz
# npm
.npm
package-lock.json
# Yarn
yarn.lock
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
# pnpm（项目使用）
.pnpm-store/
pnpm-lock.yaml.bak

# ========== 运行时文件 ==========
*.pid
*.seed
*.pid.lock
.node_repl_history

# ========== 调试与测试 ==========
.vscode-test/

# ========== 临时构建目录 ==========
tmp/
temp/
build/
