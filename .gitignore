# ==========================================
# Clipsey Browser Extension - .gitignore
# WXT Framework + Vite + TypeScript + Vue 3
# ==========================================

# Dependencies
node_modules/

# WXT Build Outputs
.output/
.wxt/
dist/
*.crx
*.zip
*.xpi

# Vite
.vite/
vite.config.ts.timestamp-*

# TypeScript
*.tsbuildinfo
*.tsbuildinfo.*

# Test Coverage
coverage/
.nyc_output/
*.lcov

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment Variables
.env
.env.local
.env.*.local
.env.production
.env.development
!.env.example

# IDE and Editor Files
.qoder/
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*.swn
*.bak
*.tmp
*.temp

# OS Files
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Tooling Caches
.eslintcache
.stylelintcache
.cache/
.parcel-cache/
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Package Manager Files
*.tgz
*.tar.gz
pnpm-lock.yaml
package-lock.json
yarn.lock
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Runtime
*.pid
*.seed
*.pid.lock

# Optional
.npm
.node_repl_history

# Debug
.vscode-test/

# Temporary Build Files
tmp/
temp/
build/

# Documentation Build (keep source docs)
# docs/.vitepress/dist
# docs/.vitepress/cache
