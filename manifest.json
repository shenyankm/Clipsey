{
  "manifest_version": 3,
  "name": "Clipsey",
  "description": "Clipsey 是一款基于 Vite、Vue 3、Ant Design Vue 和 TypeScript 的现代网页摘录工具。",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "options_page": "options/index.html",
  "permissions": ["contextMenus", "storage", "scripting", "notifications", "activeTab", "tabs"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
