{
  "name": "clipsey",
  "displayName": "Clipsey 网页摘录工具",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:chrome": "wxt -b chrome",
    "dev:edge": "wxt -b edge",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:chrome": "wxt build -b chrome",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox",
    "build:all": "pnpm build:chrome && pnpm build:edge && pnpm build:firefox",
    "zip": "wxt zip",
    "zip:chrome": "wxt zip -b chrome",
    "zip:edge": "wxt zip -b edge",
    "zip:firefox": "wxt zip -b firefox",
    "zip:all": "pnpm zip:chrome && pnpm zip:edge && pnpm zip:firefox",
    "postinstall": "wxt prepare",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run --coverage",
    "test:visual": "vitest run tests/visual-regression.spec.ts"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.6",
    "dompurify": "^3.3.0",
    "vue": "^3.5.24",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.249",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^2.1.9",
    "@wxt-dev/module-vue": "^1.0.3",
    "jsdom": "^24.1.3",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^24.29.1",
    "typescript": "^5.9.3",
    "vfonts": "^0.0.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.12",
    "wxt": "^0.20.11"
  }
}
